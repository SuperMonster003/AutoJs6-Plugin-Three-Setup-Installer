<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AndroidHiddenApiBypass declares a higher minSdk than the plugin; it is only invoked on Android 9+. -->
    <uses-sdk tools:overrideLibrary="org.lsposed.hiddenapibypass" />

    <uses-permission android:name="org.autojs.permission.PLUGIN" />
    <!-- Regular (none authorizer) installation and uninstallation through the system dialogs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Installed version, signer comparison and the default-installer state of arbitrary packages. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Progress of background installations (roadmap P3.4); the service type is declared with it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shizuku authorizer (roadmap D2 / D11). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- Used only by the user's manual GitHub release check. Installation remains offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="org.autojs.autojs6" />
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Which app currently handles package files: the default-installer state (roadmap D23). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_system"
        android:roundIcon="@mipmap/ic_launcher_system"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreeSetupInstaller"
        tools:targetApi="33">

        <activity android:name=".ui.HomeActivity" android:exported="false"
            android:configChanges="uiMode|locale|layoutDirection" />
        <activity-alias android:name=".launcher.AdaptiveLightIconAlias" android:targetActivity=".ui.HomeActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_system_light" android:roundIcon="@mipmap/ic_launcher_system_light">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.AdaptiveDarkIconAlias" android:targetActivity=".ui.HomeActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_system" android:roundIcon="@mipmap/ic_launcher_system">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.AdaptiveAutoIconAlias" android:targetActivity=".ui.HomeActivity"
            android:enabled="true" android:exported="true" android:icon="@mipmap/ic_launcher_system_auto" android:roundIcon="@mipmap/ic_launcher_system_auto">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.TransparentIconAlias" android:targetActivity=".ui.HomeActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <receiver android:name=".ui.LauncherIconUpdateReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <activity android:name=".ui.InstalledAppsActivity" android:exported="false" android:configChanges="uiMode|locale|layoutDirection" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" android:configChanges="uiMode|locale|layoutDirection" />
        <activity android:name=".ui.DefaultInstallerActivity" android:exported="false" android:configChanges="uiMode|locale|layoutDirection" />
        <activity android:name=".ui.AboutActivity" android:exported="false" android:configChanges="uiMode|locale|layoutDirection" />
        <activity android:name=".ui.ReleaseHistoryActivity" android:exported="false" android:configChanges="uiMode|locale|layoutDirection" />
        <activity android:name=".ui.InstallerSettingsActivity" android:exported="true"
            android:permission="org.autojs.permission.PLUGIN" android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter><action android:name="org.autojs.plugin.INSTALLER_SETTINGS" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".ThreeSetupInstallerPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="installer" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5299" />
        </service>

        <!--
            Host-facing installer service (roadmap D13 / P2.6), guarded by permission and caller identity.
        -->
        <service
            android:name=".ThreeSetupInstallerPluginService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INSTALLER" />
                <category android:name="installer" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5299" />
        </service>

        <activity
            android:name=".ui.ConfirmationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="uiMode|locale|layoutDirection"
            android:theme="@style/Theme.ThreeSetupInstaller.Dialog" />

        <activity android:name=".ui.InstallDialogActivity" android:exported="false"
            android:excludeFromRecents="true" android:launchMode="standard" android:documentLaunchMode="intoExisting"
            android:configChanges="uiMode|locale|layoutDirection"
            android:theme="@style/Theme.ThreeSetupInstaller.Dialog" />

        <activity android:name=".ui.UserActionActivity" android:exported="false"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity android:name=".ui.ExternalInstallActivity" android:exported="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/x-apks" />
                <data android:mimeType="application/vnd.android.package-archives" />
                <data android:mimeType="application/vnd.apkm" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/x-apkz" />
                <data android:mimeType="application/x-aab" />
                <data android:mimeType="application/vnd.android.aab" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Providers such as Files by Google use opaque IDs, not filenames, in content URIs.
                     Accept their generic MIME hints and let the archive parser validate the content. -->
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/x-apks" />
                <data android:mimeType="application/vnd.android.package-archives" />
                <data android:mimeType="application/vnd.apkm" />
                <data android:mimeType="application/xapk-package-archive" />
                <data android:mimeType="application/x-apkz" />
                <data android:mimeType="application/x-aab" />
                <data android:mimeType="application/vnd.android.aab" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service android:name=".ui.InstallForegroundService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver android:name=".ui.InstallNotifications$CancelReceiver" android:exported="false" />

        <activity
            android:name=".ui.UninstallDialogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Explicit PendingIntent target for system package-installation results. -->
        <receiver
            android:name=".engine.InstallStatusReceiver"
            android:exported="false" />

        <!-- libsu instantiates this ContextWrapper in its root process, never as an Android Service. -->
        <service
            android:name=".priv.RootInstallerService"
            android:exported="false"
            tools:ignore="Instantiatable" />

        <!-- Shizuku client registration; the authority is fixed to this application id. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
